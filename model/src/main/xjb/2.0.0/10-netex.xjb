<?xml version="1.0" encoding="UTF-8"?>
<!-- Schema-version-specific overlay for NeTEx 2.0.0. -->
<jxb:bindings version="3.0"
              xmlns:jxb="https://jakarta.ee/xml/ns/jaxb"
              xmlns:xjc="http://java.sun.com/xml/ns/jaxb/xjc"
              xmlns:xs="http://www.w3.org/2001/XMLSchema"
              jxb:extensionBindingPrefixes="xjc">

  <jxb:bindings
      schemaLocation="../../../../schemas/2.0.0/netex_framework/netex_genericFramework/netex_organisation_version.xsd">
    <jxb:bindings node="//xs:element[@name = 'Status']">
      <jxb:property name="StatusOrganisationGroup"/>
    </jxb:bindings>
    <jxb:bindings node="//xs:element[@name = 'NameOfClass']">
      <jxb:property name="NameOfClassCodespaceAssignment"/>
    </jxb:bindings>
  </jxb:bindings>

  <jxb:bindings
      schemaLocation="../../../../schemas/2.0.0/netex_part_3/part3_fares/netex_salesOfferPackage_version.xsd">
    <jxb:bindings node="//xs:element[@ref = 'ResponsibilitySetRef']">
      <jxb:property name="ResponsibilitySetRefDistributionByGroup"/>
    </jxb:bindings>
  </jxb:bindings>

  <jxb:bindings
      schemaLocation="../../../../schemas/2.0.0/netex_part_3/part3_salesTransactions/netex_salesContract_version.xsd">
    <jxb:bindings node="//xs:element[@name = 'Status']">
      <jxb:property name="StatusPassengerContractGroup"/>
    </jxb:bindings>
  </jxb:bindings>

  <jxb:bindings
      schemaLocation="../../../../schemas/2.0.0/netex_part_3/part3_salesTransactions/netex_retailConsortium_version.xsd">
    <jxb:bindings node="//xs:element[@name = 'Status']">
      <jxb:property name="StatusRetailDeviceGroup"/>
    </jxb:bindings>
  </jxb:bindings>

  <jxb:bindings
      schemaLocation="../../../../schemas/2.0.0/netex_framework/netex_responsibility/netex_version_support.xsd">
    <jxb:bindings node="//xs:simpleType[@name = 'VersionIdType']">
      <xjc:javaType name="java.lang.String" adapter="noi.netex.xml.VersionIdAdapter"/>
    </jxb:bindings>
    <jxb:bindings node="//xs:attributeGroup[@name = 'BasicModificationDetailsGroup']/xs:attribute[@name = 'status']">
      <jxb:property name="status_BasicModificationDetailsGroup"/>
    </jxb:bindings>
    <jxb:bindings
        node="//xs:attributeGroup[@name = 'BasicModificationDetailsGroup']/xs:attribute[@name = 'derivedFromVersionRef']">
      <jxb:property name="derivedFromVersionRef_BasicModificationDetailsGroup"/>
    </jxb:bindings>
  </jxb:bindings>

  <jxb:bindings
      schemaLocation="../../../../schemas/2.0.0/netex_part_1/part1_tacticalPlanning/netex_servicePattern_version.xsd">
    <jxb:bindings node="//xs:element[@name = 'BookingArrangements']">
      <jxb:property name="BookingArrangementsDeprecated"/>
    </jxb:bindings>
  </jxb:bindings>

  <jxb:bindings
      schemaLocation="../../../../schemas/2.0.0/netex_part_1/part1_ifopt/netex_assistanceBooking_version.xsd">
    <jxb:bindings node="//xs:element[@name = 'BookingArrangements']">
      <jxb:property name="BookingArrangementsDeprecated"/>
    </jxb:bindings>
  </jxb:bindings>

  <jxb:bindings
      schemaLocation="../../../../schemas/2.0.0/netex_part_3/part3_fares/netex_usageParameterBooking_version.xsd">
    <jxb:bindings node="//xs:group[@name = 'ReservingGroup']//xs:element[@name = 'BookingArrangements']">
      <jxb:property name="BookingArrangementsDeprecated"/>
    </jxb:bindings>
    <jxb:bindings node="//xs:group[@name = 'CancellingGroup']//xs:element[@name = 'BookingArrangements']">
      <jxb:property name="BookingArrangementsDeprecated"/>
    </jxb:bindings>
  </jxb:bindings>

  <jxb:bindings
      schemaLocation="../../../../schemas/2.0.0/netex_part_5/part5_rc/netex_nm_mobilityService_version.xsd">
    <jxb:bindings node="//xs:element[@name = 'ServiceBookingArrangements']">
      <jxb:property name="ServiceBookingArrangementsDeprecated"/>
    </jxb:bindings>
  </jxb:bindings>

  <jxb:bindings
      schemaLocation="../../../../schemas/2.0.0/netex_framework/netex_reusableComponents/netex_mode_support.xsd">
    <jxb:bindings node="//xs:simpleType[@name = 'AllPublicTransportModesEnumeration']">
      <jxb:typesafeEnumClass name="AllVehicleModesOfTransportEnumeration"/>
    </jxb:bindings>
  </jxb:bindings>

  <jxb:bindings
      schemaLocation="../../../../schemas/2.0.0/netex_framework/netex_genericFramework/netex_zone_version.xsd">
    <jxb:bindings
        node="//xs:complexType[@name = 'tariffZonesInFrame_RelStructure']/xs:complexContent/xs:extension[@base = 'containmentAggregationStructure']/xs:sequence/xs:element[@ref = 'TariffZone_Dummy']">
      <jxb:property name="tariffZone"/>
    </jxb:bindings>
  </jxb:bindings>

  <jxb:bindings
      schemaLocation="../../../../schemas/2.0.0/netex_framework/netex_reusableComponents/netex_dayType_version.xsd">
    <jxb:bindings
        node="//xs:complexType[@name = 'dayTypes_RelStructure']/xs:complexContent/xs:extension[@base = 'containmentAggregationStructure']/xs:choice">
      <jxb:property name="dayTypeRefOrDayType_"/>
    </jxb:bindings>
  </jxb:bindings>

  <jxb:bindings
      schemaLocation="../../../../schemas/2.0.0/netex_framework/netex_responsibility/netex_validityCondition_version.xsd">
    <jxb:bindings
        node="//xs:complexType[@name = 'validityConditions_RelStructure']/xs:complexContent/xs:extension[@base = 'containmentAggregationStructure']/xs:choice">
      <jxb:property name="validityConditionRefOrValidBetweenOrValidityCondition_"/>
    </jxb:bindings>
  </jxb:bindings>

  <jxb:bindings
      schemaLocation="../../../../schemas/2.0.0/netex_framework/netex_reusableComponents/netex_noticeAssignment_version.xsd">
    <jxb:bindings
        node="//xs:complexType[@name = 'noticeAssignments_RelStructure']/xs:complexContent/xs:extension[@base = 'containmentAggregationStructure']/xs:choice">
      <jxb:property name="noticeAssignment_OrNoticeAssignmentView"/>
    </jxb:bindings>
  </jxb:bindings>

</jxb:bindings>
