<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>noi.spike</groupId>
  <artifactId>netex-toolkit</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>
  <name>NeTEx Toolkit</name>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <!-- XML parsing. stax2-api is declared because org.codehaus.stax2 types are imported
         directly by toolkit.codec.RefPatcher, toolkit.load.CopyingCapture, toolkit.load
         .NetexLoader and the source-launched tools/diff/RoundTrip and tools/inspect/nx/XmlFind. -->
    <dependency>
      <groupId>com.fasterxml</groupId>
      <artifactId>aalto-xml</artifactId>
      <version>1.4.0</version>
    </dependency>
    <dependency>
      <groupId>org.codehaus.woodstox</groupId>
      <artifactId>stax2-api</artifactId>
      <version>4.3.0</version>
    </dependency>

    <!-- JAXB (jakarta) runtime + API -->
    <dependency>
      <groupId>jakarta.xml.bind</groupId>
      <artifactId>jakarta.xml.bind-api</artifactId>
      <version>4.0.2</version>
    </dependency>
    <dependency>
      <groupId>org.glassfish.jaxb</groupId>
      <artifactId>jaxb-runtime</artifactId>
      <version>4.0.5</version>
    </dependency>

    <!-- The NeTEx model: noi.netex.model / noi.netex.gml / noi.netex.siri, generated by
         ../model from the committed schemas. Its date/time carriers keep the source lexical
         form, so a re-marshal is byte-exact. -->
    <dependency>
      <groupId>noi.spike</groupId>
      <artifactId>netex-model</artifactId>
      <version>0.1.0-SNAPSHOT</version>
    </dependency>

    <!-- Logging. Compile scope, not test/provided: the scripts under ../scripts run source-
         launched against target/deps, so the binding has to be copied there. -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>2.0.18</version>
    </dependency>
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
      <version>1.5.38</version>
    </dependency>

    <!-- Storage -->
    <dependency>
      <groupId>org.lmdbjava</groupId>
      <artifactId>lmdbjava</artifactId>
      <version>0.9.3</version>
    </dependency>

    <!-- Collections / graph -->
    <dependency>
      <groupId>it.unimi.dsi</groupId>
      <artifactId>fastutil</artifactId>
      <version>8.5.15</version>
    </dependency>

    <!-- Value formats -->
    <dependency>
      <groupId>org.lz4</groupId>
      <artifactId>lz4-java</artifactId>
      <version>1.8.0</version>
    </dependency>

    <!-- CRS reprojection for the EPIP ensemble op -->
    <dependency>
      <groupId>org.locationtech.proj4j</groupId>
      <artifactId>proj4j</artifactId>
      <version>1.3.0</version>
    </dependency>
    <dependency>
      <groupId>org.locationtech.proj4j</groupId>
      <artifactId>proj4j-epsg</artifactId>
      <version>1.3.0</version>
    </dependency>

    <!-- Test scope, and it must stay that way. toolkit.test (Check, Gen, TestStore, Xml, Runner)
         ships in the production jar so a downstream consumer can test a driver it wrote itself,
         with no JUnit and no build step. Only the suite's own runner needs JUnit, so only
         src/test/java is compiled against it. Same version as ../model, so one JUnit is on the
         reactor. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>6.1.0</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>netex-toolkit</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>

      <!-- The suite: src/test/java, in the package of whatever each file tests, discovered by
           surefire. The tests compile against target/classes instead of the built jar, so the
           stale-jar trap (OPEN.md 14) cannot hit them.

           One JVM: surefire's default forkCount=1/reuseForks=true. The fixed cost is JVM start
           and JAXB context init, worth ~15x.

           The two flags below are warning suppression, NOT correctness. Measured on JDK 25
           (Temurin 25.0.4.1): the store loads, resolves and reads with no flags at all. What they
           silence is jffi's System::load and its Unsafe::putLong, plus lz4-java's
           System::loadLibrary, which is a second and independent native caller with nothing to do
           with lmdbjava. The JVM names only the first restricted-method caller per module, so no
           single run shows both.

           (Flag names below are written without their leading dashes on purpose: an XML comment
           may not contain two dashes in a row, and restoring them makes this pom unparseable.)

           This set carried four "add-opens" flags, on java.nio, sun.nio.ch, java.lang and
           java.lang.reflect, until they were measured and found dead: they are ByteBufferProxy's
           requirement, and AbstractLmdbStore builds its Env on ByteArrayProxy.PROXY_BA, so that
           class never loads. DO NOT ADD THEM BACK without a run that fails without them.

           "sun-misc-unsafe-memory-access" stops being cosmetic on JDK 26, where JEP 498 made
           `deny` its default and jffi's putLong would throw. ../noi-pipeline/Makefile passes the
           same set. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.4</version>
        <configuration>
          <argLine>
            -Xmx4g
            --enable-native-access=ALL-UNNAMED
            --sun-misc-unsafe-memory-access=allow
          </argLine>
          <systemPropertyVariables>
            <!-- The tree scans (TestConf, TestProvenance, TestStoreFormat, TestHarnessExamples)
                 read four roots, three of which are this module's SIBLINGS, and surefire's working
                 directory is the module. toolkit.Sources refuses rather than guessing. -->
            <toolkit.repo.dir>${project.basedir}/..</toolkit.repo.dir>
          </systemPropertyVariables>
          <!-- TestConf launches a probe JVM on THIS one's java.class.path, and the manifest-only
               jar surefire otherwise hands it names one booter jar the child cannot compile
               against. The probe's operative-first guard would catch it, loudly, on every run. -->
          <useManifestOnlyJar>false</useManifestOnlyJar>
          <properties>
            <!-- Registers toolkit.test.TestStoreExtension from
                 src/test/resources/META-INF/services, so a test class needs no @ExtendWith to be
                 handed a TestStore: the reflective discovery Runner had, kept. -->
            <configurationParameters>
              junit.jupiter.extensions.autodetection.enabled = true
            </configurationParameters>
          </properties>
        </configuration>
      </plugin>

      <!-- The API is documented in package-info.java per package and in class javadoc, both of
           which lean on {@link} cross-references. A broken one is invisible without this.

           doclint is reference-only: the full doclint would demand @param/@return on every method
           and drown the signal. This asks one question — does every link resolve? — and fails the
           build when one does not. `mvn javadoc:javadoc` renders the html on demand; this
           execution only checks. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <version>3.11.2</version>
        <executions>
          <execution>
            <id>check-javadoc-references</id>
            <phase>verify</phase>
            <goals><goal>javadoc-no-fork</goal></goals>
            <configuration>
              <doclint>reference</doclint>
              <quiet>true</quiet>
              <failOnWarnings>true</failOnWarnings>
              <detectJavaApiLink>false</detectJavaApiLink>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- target/deps holds the runtime classpath. The scripts under ../scripts are launched as
           JEP-458 source programs against "netex-toolkit.jar:deps/*", so the jar alone is not
           runnable and this execution is not optional. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.7.1</version>
        <executions>
          <execution>
            <id>copy-deps</id>
            <phase>package</phase>
            <goals><goal>copy-dependencies</goal></goals>
            <configuration>
              <outputDirectory>${project.build.directory}/deps</outputDirectory>
              <includeScope>runtime</includeScope>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- netex-toolkit-shaded.jar — the whole runtime classpath in one file.
           Attached, not a replacement: netex-toolkit.jar + deps/ stays as it was, because this
           build, tools/gate/*.sh and the script suite launch against it. The shaded artifact is
           for consumers, who copy one file instead of a jar plus 31 loose ones.

           An uber jar's usual way to fail is a META-INF/services file silently overwritten by
           another jar's copy of the same name. Here every service file has one provider, and
           ServicesResourceTransformer preserves each: jakarta.xml.bind.JAXBContextFactory
           (jaxb-runtime) and org.slf4j.spi.SLF4JServiceProvider (logback-classic) are
           load-bearing — FragmentCodec's JAXBContext.newInstance and the logging binding resolve
           through them — and javax.xml.stream.XMLInputFactory/XMLOutputFactory/XMLEventFactory
           come from aalto-xml alone. A second StAX implementation on this classpath would make
           the merge concatenate providers and change what newInstance() returns.

           module-info.class is dropped from all 18 jars that carry one: a single jar cannot carry
           18 module descriptors, and the classpath launch this jar is for does not read them. Of
           the two Multi-Release dependencies (slf4j-api, logback-core) neither ships any versioned
           class but a module-info, so no code is lost and the jar needs no Multi-Release manifest
           entry.

           Licence files are not filtered out, but they are also not complete: three jars ship
           META-INF/LICENSE and six ship META-INF/LICENSE.md, and a zip has one entry per path, so
           one of each set wins arbitrarily. README Licensing names pom.xml plus its transitive
           closure as the authoritative list instead. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <id>shaded-jar</id>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <shadedArtifactAttached>true</shadedArtifactAttached>
              <shadedClassifierName>shaded</shadedClassifierName>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <!-- A stable, version-free filename, set explicitly: left to itself the plugin
                   writes artifactId-version-classifier, i.e. netex-toolkit-0.1.0-SNAPSHOT-shaded
                   .jar, which puts the version in a path that ../noi-pipeline's Makefile, tools
                   and this pom's own gate all hardcode. -->
              <finalName>${project.build.finalName}-shaded</finalName>
              <!-- No relocation. Relocating would rewrite package names inside the bytes, and
                   ModelRegistry feeds literal package-name strings to Class.forName and
                   JAXBContext.newInstance — a rewrite there fails at runtime, not at build. -->
              <transformers>
                <transformer
                  implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                <transformer
                  implementation="org.apache.maven.plugins.shade.resource.ApacheNoticeResourceTransformer">
                  <addHeader>false</addHeader>
                </transformer>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/versions/*/module-info.class</exclude>
                    <!-- No dependency is signed today; if one ever is, its signature would not
                         survive repackaging and would break verification at class load. -->
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>META-INF/*.EC</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- The build's own gates. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <!-- Exactly one NeTEx model on the runtime classpath, and it is ours.
               A second, differently-packaged copy fails silently: a stray
               `import <other>.netex.model.X` in an uncompiled JEP-458 script under scripts/
               compiles and runs against beans FragmentCodec's JAXBContext does not know and
               ModelRegistry does not have, giving an unregistered class -> DataManagedObject
               fallback -> edges into _unresolved. Nothing fails; the data is wrong.

               Gate the bytes, not the coordinates. A banned-GAV rule matches the dependency tree,
               which a module can evade by taking the offending jar at `provided` scope (not
               transitive, so the tree looks clean) and unpacking its classes into its own jar.
               Repackaging, shading and unpacking do not evade a content scan.

               The markers below are NeTEx type names — properties of the standard, which any
               generated NeTEx model must carry, whatever its coordinates or Java package — rather
               than a denylist of one package.

               Phase is `package`, and this must stay declared after maven-dependency-plugin's
               copy-deps execution AND after maven-shade-plugin: it reads what both produced. The
               shaded jar is scanned too, being the artifact a consumer takes.

               `jar tf`, not `unzip`: the build image has no unzip. -->
          <execution>
            <id>assert-one-netex-model-on-classpath</id>
            <phase>package</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <executable>bash</executable>
              <arguments>
                <argument>-c</argument>
                <argument><![CDATA[
                  deps="${project.build.directory}/deps"
                  main="${project.build.directory}/${project.build.finalName}.jar"
                  shaded="${project.build.directory}/${project.build.finalName}-shaded.jar"
                  # Operative-first: an empty deps/ must fail loudly rather than pass silently.
                  if [ ! -d "$deps" ]; then
                    echo "GATE INOPERATIVE: $deps missing (did copy-dependencies run before this?)"
                    exit 1
                  fi
                  n=$(find "$deps" -name '*.jar' | wc -l)
                  if [ "$n" -lt 10 ]; then
                    echo "GATE INOPERATIVE: only $n jars in $deps (expect ~28)."
                    exit 1
                  fi
                  if [ ! -f "$main" ]; then
                    echo "GATE INOPERATIVE: $main missing (declare this after maven-jar-plugin)."
                    exit 1
                  fi
                  if [ ! -f "$shaded" ]; then
                    echo "GATE INOPERATIVE: $shaded missing (declare this after maven-shade-plugin)."
                    exit 1
                  fi
                  # NeTEx type names, and NeTEx-specific enough that a class file with one of
                  # these basenames is a NeTEx model class wherever it sits. Any generated NeTEx
                  # model has all four.
                  markers='PublicationDeliveryStructure|ServiceJourney|ScheduledStopPoint|DataManagedObjectStructure'

                  # `while read` over `find -print0`: an evasion gate that is itself sloppy about
                  # what a filename may contain is a bad advertisement for the practice.
                  bad=""
                  ours=0
                  scanned=0
                  while IFS= read -r -d '' j; do
                    scanned=$((scanned+1))
                    hits=$(jar tf "$j" 2>/dev/null | grep -E "(^|/)($markers)\.class$" || true)
                    [ -z "$hits" ] && continue
                    ours=$((ours + $(echo "$hits" | grep -c '^noi/netex/' || true)))
                    foreign=$(echo "$hits" | grep -v '^noi/netex/' || true)
                    [ -n "$foreign" ] && bad="$bad$j"$'\n'"$(echo "$foreign" | sed 's/^/    /')"$'\n'
                  done < <(printf '%s\0' "$main" "$shaded"; find "$deps" -name '*.jar' -print0 | sort -z)

                  # OPERATIVE-FIRST. If the markers match nothing at all, they have gone stale
                  # against the schema and this gate is scanning for a shape that no longer
                  # exists -- which passes silently, the one failure mode a gate must not have.
                  if [ "$ours" -eq 0 ]; then
                    echo "GATE INOPERATIVE: none of the NeTEx marker types was found under"
                    echo "noi/netex/ in any of the $scanned jars scanned. Either netex-model is"
                    echo "missing from the classpath, or the marker list below no longer names"
                    echo "types this model generates. Fix the markers; do not delete the check."
                    echo "  markers: $markers"
                    exit 1
                  fi
                  if [ -n "$bad" ]; then
                    echo "A SECOND NETEX MODEL IS ON THE RUNTIME CLASSPATH — NeTEx types outside"
                    echo "noi/netex/ are present in:"
                    printf '%s' "$bad"
                    echo
                    echo "The NeTEx model here is noi.netex.model, and it must be the only one --"
                    echo "not directly, not transitively, and not unpacked into another jar. A"
                    echo "second copy makes reference resolution fail SILENTLY (unregistered class"
                    echo "-> DataManagedObject fallback -> edges into _unresolved). Remove the"
                    echo "dependency or the unpack. If you need foreign model classes as a TEST"
                    echo "oracle, vendor the individual sources you need under a noi.* package."
                    exit 1
                  fi
                  echo "[gate] one NeTEx model on the runtime classpath, under noi/netex/ ($scanned jars scanned)"
                ]]></argument>
              </arguments>
            </configuration>
          </execution>

          <!-- The shaded jar is the one artefact nothing else here exercises: `mvn verify` and
               tools/gate/*.sh both run against netex-toolkit.jar + deps/, so a broken shaded jar
               would leave every green green. An uber jar breaks by having a META-INF/services file
               overwritten instead of merged, or a dependency filtered out — both produce a jar
               that builds, uploads, downloads, and dies on first use elsewhere.

               So the shape is asserted directly. Presence checks, not a run: a run would need a
               store and a feed, which is the suite's job on the other classpath. -->
          <execution>
            <id>assert-shaded-jar-is-complete</id>
            <phase>package</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <executable>bash</executable>
              <arguments>
                <argument>-c</argument>
                <argument><![CDATA[
                  shaded="${project.build.directory}/${project.build.finalName}-shaded.jar"
                  if [ ! -f "$shaded" ]; then
                    echo "GATE INOPERATIVE: $shaded missing (did maven-shade-plugin run?)"
                    exit 1
                  fi
                  listing=$(jar tf "$shaded") || { echo "GATE INOPERATIVE: cannot read $shaded"; exit 1; }
                  n=$(printf '%s\n' "$listing" | wc -l)
                  # A shaded jar that lost its dependencies still contains the toolkit's own ~300
                  # entries and would pass every check below that names a toolkit class. The floor
                  # is what makes "it has everything" mean something.
                  if [ "$n" -lt 8000 ]; then
                    echo "GATE INOPERATIVE: $shaded holds only $n entries (expect >= 8000)."
                    echo "That is the toolkit without its dependencies -- the shade did not bundle."
                    exit 1
                  fi
                  missing=""
                  # One marker per bundled tier: our code, the model, and every third-party
                  # dependency a driver actually reaches at runtime.
                  for e in \
                    toolkit/store/Store.class \
                    toolkit/transform/epip/EpipJourneys.class \
                    noi/netex/model/ObjectFactory.class \
                    com/fasterxml/aalto/stax/InputFactoryImpl.class \
                    com/fasterxml/aalto/stax/OutputFactoryImpl.class \
                    jakarta/xml/bind/JAXBContext.class \
                    org/glassfish/jaxb/runtime/v2/ContextFactory.class \
                    org/lmdbjava/Env.class \
                    it/unimi/dsi/fastutil/longs/Long2ObjectOpenHashMap.class \
                    net/jpountz/lz4/LZ4Factory.class \
                    org/locationtech/proj4j/CRSFactory.class \
                    org/slf4j/LoggerFactory.class \
                    ch/qos/logback/classic/LoggerContext.class \
                    META-INF/services/jakarta.xml.bind.JAXBContextFactory \
                    META-INF/services/org.slf4j.spi.SLF4JServiceProvider ; do
                    printf '%s\n' "$listing" | grep -qxF "$e" || missing="$missing  $e"$'\n'
                  done
                  if [ -n "$missing" ]; then
                    echo "SHADED JAR IS INCOMPLETE — these entries are not in $shaded:"
                    printf '%s' "$missing"
                    echo "A services/ entry missing means ServicesResourceTransformer did not run or"
                    echo "was overwritten: JAXBContext.newInstance or the logging binding will fail at"
                    echo "first use, in the consumer's repository rather than here. A class missing"
                    echo "means a dependency was filtered out of the shade."
                    exit 1
                  fi
                  # 18 dependencies carry one; a jar cannot have 18 module descriptors, and one
                  # surviving at the root would make this jar a broken automatic module.
                  if printf '%s\n' "$listing" | grep -q 'module-info\.class$'; then
                    echo "SHADED JAR CARRIES module-info.class — the shade filter did not apply:"
                    printf '%s\n' "$listing" | grep 'module-info\.class$'
                    exit 1
                  fi
                  echo "[gate] $(basename "$shaded") complete: $n entries, every marker present, no module-info"
                ]]></argument>
              </arguments>
            </configuration>
          </execution>

        </executions>
      </plugin>
    </plugins>
  </build>
</project>
